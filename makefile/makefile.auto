ifneq ($(VERBOSE),1)
VV=@
endif

CC=/usr/bin/gcc
MM=/usr/bin/gcc
AS=/usr/bin/gcc
MXX=/usr/bin/g++
FC=/usr/bin/gfortran
CU=/usr/bin/clang
CXX=/usr/bin/g++
RC=/home/arthus/.cargo/bin/rustc

FCSH=/usr/bin/gfortran
SH=/usr/bin/g++
RCSH=/home/arthus/.cargo/bin/rustc
FCLD=/usr/bin/gfortran
LD=/usr/bin/g++
RCLD=/home/arthus/.cargo/bin/rustc
AR=/usr/bin/ar
RCAR=/home/arthus/.cargo/bin/rustc

PFR-hardware_LD=/usr/bin/g++
PFR-hardware_CC=/usr/bin/gcc
PFR-simulator_LD=/usr/bin/g++
PFR-simulator_CC=/usr/bin/gcc

PFR-hardware_CCFLAGS=-m64 -fvisibility=hidden -O3 -I../include -DNDEBUG
PFR-hardware_LDFLAGS=-m64 -s
PFR-simulator_CCFLAGS=-m64 -fvisibility=hidden -O3 -I../include -Wall -Wextra -DNDEBUG
PFR-simulator_LDFLAGS=-m64 -s

default:  PFR-hardware PFR-simulator

all:  PFR-hardware PFR-simulator

.PHONY: default all  PFR-hardware PFR-simulator

PFR-hardware: ../build/linux/x86_64/release/PFR-hardware
../build/linux/x86_64/release/PFR-hardware: ../build/.objs/PFR-hardware/linux/x86_64/release/source/main.c.o
	@echo linking.release PFR-hardware
	@mkdir -p ../build/linux/x86_64/release
	$(VV)$(PFR-hardware_LD) -o ../build/linux/x86_64/release/PFR-hardware ../build/.objs/PFR-hardware/linux/x86_64/release/source/main.c.o $(PFR-hardware_LDFLAGS)

../build/.objs/PFR-hardware/linux/x86_64/release/source/main.c.o: ../source/main.c
	@echo compiling.release ../source/main.c
	@mkdir -p ../build/.objs/PFR-hardware/linux/x86_64/release/source
	$(VV)$(PFR-hardware_CC) -c $(PFR-hardware_CCFLAGS) -o ../build/.objs/PFR-hardware/linux/x86_64/release/source/main.c.o ../source/main.c

PFR-simulator: ../build/linux/x86_64/release/PFR-simulator
../build/linux/x86_64/release/PFR-simulator: ../build/.objs/PFR-simulator/linux/x86_64/release/source/main.c.o
	@echo linking.release PFR-simulator
	@mkdir -p ../build/linux/x86_64/release
	$(VV)$(PFR-simulator_LD) -o ../build/linux/x86_64/release/PFR-simulator ../build/.objs/PFR-simulator/linux/x86_64/release/source/main.c.o $(PFR-simulator_LDFLAGS)

../build/.objs/PFR-simulator/linux/x86_64/release/source/main.c.o: ../source/main.c
	@echo compiling.release ../source/main.c
	@mkdir -p ../build/.objs/PFR-simulator/linux/x86_64/release/source
	$(VV)$(PFR-simulator_CC) -c $(PFR-simulator_CCFLAGS) -o ../build/.objs/PFR-simulator/linux/x86_64/release/source/main.c.o ../source/main.c

clean:  clean_PFR-hardware clean_PFR-simulator

clean_PFR-hardware: 
	@rm -rf ../build/linux/x86_64/release/PFR-hardware
	@rm -rf ../build/linux/x86_64/release/PFR-hardware.sym
	@rm -rf ../build/.objs/PFR-hardware/linux/x86_64/release/source/main.c.o

clean_PFR-simulator: 
	@rm -rf ../build/linux/x86_64/release/PFR-simulator
	@rm -rf ../build/linux/x86_64/release/PFR-simulator.sym
	@rm -rf ../build/.objs/PFR-simulator/linux/x86_64/release/source/main.c.o

